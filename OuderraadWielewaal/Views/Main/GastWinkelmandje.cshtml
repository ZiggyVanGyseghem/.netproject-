@model List<OuderraadWielewaal.Models.WinkelmandItem>
@{
    ViewData["Title"] = "Jouw Winkelmandje";
}

<div class="container mt-4">
    <h2 class="mb-4">Jouw Bestelling (Tafel @ViewBag.TafelNummer)</h2>

    @if (Model == null || !Model.Any())
    {
        <div class="alert alert-info shadow-sm">Je winkelmandje is nog leeg. Voeg snel iets lekkers toe!</div>
        <a asp-controller="Main" asp-action="GastMenu" class="btn btn-primary fw-bold">Terug naar Menu</a>
    }
    else
    {
        <div class="table-responsive shadow-sm bg-white rounded">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Product</th>
                        <th>Prijs</th>
                        <th>Aantal</th>
                        <th>Subtotaal</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td><strong>@item.Naam</strong></td>
                            <td>€ @item.Prijs.ToString("0.00")</td>
                            <td>@item.Aantal x</td>
                            <td><strong>€ @item.Subtotaal.ToString("0.00")</strong></td>
                            <td class="text-end">
                                <a asp-controller="Main" asp-action="GastVerwijder" asp-route-productId="@item.ProductId" class="btn btn-sm btn-outline-danger" title="Verwijder dit item">
                                    Verwijder
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
                <tfoot class="table-dark">
                    <tr>
                        <td colspan="3" class="text-end"><strong>Totaal te betalen:</strong></td>
                        <td colspan="2"><strong>€ @Model.Sum(i => i.Subtotaal).ToString("0.00")</strong></td>
                    </tr>
                </tfoot>
            </table>
        </div>
        <div class="d-flex justify-content-between mt-4">
            <a asp-controller="Main" asp-action="GastMenu" class="btn btn-outline-secondary fw-bold">Verder winkelen</a>

            <form asp-controller="Main" asp-action="GastAfrekenen" method="post">
                <button type="submit" class="btn btn-success btn-lg fw-bold shadow">
                    Afrekenen & Betalen
                </button>
            </form>
        </div>
    }
</div>
