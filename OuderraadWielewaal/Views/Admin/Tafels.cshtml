@model IEnumerable<OuderraadWielewaal.Models.Tafel>
@{
    ViewData["Title"] = "Tafelbeheer";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
        <h1>Tafelbeheer</h1>
        <div class="d-flex gap-2 flex-wrap">
            <a asp-action="NieuweTafel" class="btn btn-primary fw-bold">+ Nieuwe Tafel</a>
            <a asp-action="QRCodes" class="btn btn-outline-secondary fw-bold">QR-Codes Afdrukken</a>
        </div>
    </div>

    <div class="d-flex gap-2 mb-4">
        <form asp-action="ActiveerAlle" method="post">
            <button type="submit" class="btn btn-success fw-bold">Activeer Alle Tafels</button>
        </form>
        <form asp-action="DeactiveerAlle" method="post">
            <button type="submit" class="btn btn-danger fw-bold">Deactiveer Alle Tafels</button>
        </form>
    </div>

    <div class="table-responsive shadow-sm bg-white rounded">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-dark">
                <tr>
                    <th>#</th>
                    <th>Tafel Nummer</th>
                    <th>Status</th>
                    <th>Unieke Code</th>
                    <th>Acties</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var tafel in Model)
                {
                    <tr>
                        <td>@tafel.Id</td>
                        <td><strong>Tafel @tafel.Nummer</strong></td>
                        <td>
                            @if (tafel.Actief)
                            {
                                <span class="badge bg-success">Actief</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Inactief</span>
                            }
                        </td>
                        <td>
                            <code class="small">@(tafel.UniekeCode != null ? tafel.UniekeCode.Substring(0, 12) + "..." : "—")</code>
                        </td>
                        <td class="d-flex gap-2">
                            <form asp-action="ToggleTafel" method="post">
                                <input type="hidden" name="id" value="@tafel.Id" />
                                <button type="submit" class="btn btn-sm @(tafel.Actief ? "btn-warning" : "btn-success") fw-bold">
                                    @(tafel.Actief ? "Deactiveer" : "Activeer")
                                </button>
                            </form>
                            @if (tafel.Actief && tafel.UniekeCode != null)
                            {
                                <a asp-action="QRCodes" class="btn btn-sm btn-outline-primary">QR</a>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
