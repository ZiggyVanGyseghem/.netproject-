@model OuderraadWielewaal.ViewModels.EditUserViewModel
@{
    ViewData["Title"] = "Gebruiker Bewerken";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow">
                <div class="card-header bg-primary text-white">
                    <h3 class="mb-0">Gebruiker Bewerken</h3>
                </div>
                <div class="card-body">
                    <form asp-action="BewerkGebruiker" method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                        <input type="hidden" asp-for="Id" />

                        <div class="mb-3">
                            <label asp-for="Naam" class="form-label">Volledige Naam</label>
                            <input asp-for="Naam" class="form-control" />
                            <span asp-validation-for="Naam" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="UserName" class="form-label">Gebruikersnaam</label>
                            <input asp-for="UserName" class="form-control" />
                            <span asp-validation-for="UserName" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Rol" class="form-label">Rol</label>
                            <select asp-for="Rol" class="form-select" asp-items="ViewBag.Rollen"></select>
                            <span asp-validation-for="Rol" class="text-danger"></span>
                        </div>

                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-primary fw-bold">Opslaan</button>
                            <a asp-action="Gebruikers" class="btn btn-outline-secondary">Annuleren</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
