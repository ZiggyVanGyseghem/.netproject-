@model OuderraadWielewaal.ViewModels.CreateUserViewModel

@{
    ViewData["Title"] = "Nieuwe Medewerker";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card shadow-sm">
                <div class="card-body p-4">
                    <h3 class="mb-4">➕ Nieuwe Medewerker Aanmaken</h3>

                    <form asp-action="MaakGebruiker" method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <div class="mb-3">
                            <label asp-for="Naam" class="form-label fw-bold">Volledige Naam of Tafel Naam</label>
                            <input asp-for="Naam" class="form-control" placeholder="Bijv. Jan Peeters of Tafel 1" />
                            <span asp-validation-for="Naam" class="text-danger"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="Rol" class="form-label fw-bold">Kies een Rol</label>
                            <select asp-for="Rol" class="form-select" asp-items="ViewBag.Rollen">
                                <option value="">-- Selecteer een afdeling --</option>
                            </select>
                            <span asp-validation-for="Rol" class="text-danger"></span>
                        </div>

                        <div class="d-flex justify-content-between">
                            <a asp-action="Index" class="btn btn-outline-secondary fw-bold">Annuleren</a>
                            <button type="submit" class="btn btn-success fw-bold px-4">Opslaan</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>