@model OuderraadWielewaal.ViewModels.LoginViewModel

@{
    ViewData["Title"] = "Inloggen Medewerkers";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-4">
            <div class="card shadow-sm">
                <div class="card-body p-4">
                    <h3 class="text-center mb-4">🔐 Inloggen</h3>

                    <form asp-controller="Account" asp-action="Login" method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <div class="mb-3">
                            <label asp-for="Gebruikersnaam" class="form-label fw-bold">Gebruikersnaam</label>
                            <input asp-for="Gebruikersnaam" class="form-control" placeholder="Bijv. admin" />
                            <span asp-validation-for="Gebruikersnaam" class="text-danger"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="Wachtwoord" class="form-label fw-bold">Wachtwoord</label>
                            <input asp-for="Wachtwoord" class="form-control" placeholder="••••••••" />
                            <span asp-validation-for="Wachtwoord" class="text-danger"></span>
                        </div>

                        <button type="submit" class="btn btn-primary w-100 fw-bold fs-5">Inloggen</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>