@using Microsoft.AspNetCore.Identity
@using OuderraadWielewaal.Models
@inject SignInManager<Gebruiker> SignInManager
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - OuderraadWielewaal</title>
    <script type="importmap"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/OuderraadWielewaal.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-dark bg-dark mb-4">
            <div class="container">
                <a class="navbar-brand" asp-controller="Main" asp-action="Index">ORW Bestellingen</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarNav">
                    <ul class="navbar-nav ms-auto align-items-center">
                        @if (SignInManager.IsSignedIn(User))
                        {
                            @if (User.IsInRole("Keuken") || User.IsInRole("Administrator"))
                            {
                                <li class="nav-item me-2">
                                    <a class="nav-link btn btn-outline-danger text-danger fw-bold px-3 py-1" asp-controller="Keuken" asp-action="Index">
                                        Keuken Dashboard
                                    </a>
                                </li>
                            }

                            @if (User.IsInRole("Bar") || User.IsInRole("Administrator"))
                            {
                                <li class="nav-item me-3">
                                    <a class="nav-link btn btn-outline-warning text-warning fw-bold px-3 py-1" asp-controller="Bar" asp-action="Index">
                                        Bar Dashboard
                                    </a>
                                </li>
                            }
                            @if (User.IsInRole("Zaal") || User.IsInRole("Administrator"))
                            {
                                <li class="nav-item me-2">
                                    <a class="nav-link btn btn-outline-primary text-primary fw-bold px-3 py-1" asp-controller="Zaal" asp-action="Index">
                                        Zaal Dashboard
                                    </a>
                                </li>
                            }

                            @if (!User.IsInRole("Keuken") && !User.IsInRole("Bar") && !User.IsInRole("Zaal") && !User.IsInRole("Administrator"))
                            {
                                <li class="nav-item me-3">
                                    <a class="nav-link btn btn-warning text-dark fw-bold px-3 py-1" asp-controller="Main" asp-action="Winkelmandje">
                                        Winkelmandje
                                    </a>
                                </li>
                            }

                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle fw-bold text-primary" href="#" id="adminMenu" role="button" data-bs-toggle="dropdown">
                                    Welkom, @User.Identity?.Name!
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end">
                                    @if (User.IsInRole("Administrator"))
                                    {
                                        <li><a class="dropdown-item" asp-controller="Admin" asp-action="Index">Beheerpaneel</a></li>
                                        <li><hr class="dropdown-divider"></li>
                                    }
                                    <li>
                                        <form asp-controller="Account" asp-action="Logout" method="post">
                                            <button type="submit" class="dropdown-item text-danger">Log uit</button>
                                        </form>
                                    </li>
                                </ul>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Account" asp-action="Login">Inloggen</a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - OuderraadWielewaal - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>